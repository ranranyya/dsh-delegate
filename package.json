{
  "name": "dsh-taskbridge",
  "version": "1.4.2",
  "description": "让 Claude Code 或 Codex 指挥 DSH 完成任务；在 DSH 插件中配置 API、执行模型、思考强度、权限审批与集中审查。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ranranyya/dsh-taskbridge.git"
  },
  "homepage": "https://github.com/ranranyya/dsh-taskbridge#readme",
  "bugs": {
    "url": "https://github.com/ranranyya/dsh-taskbridge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./mcp": {
      "types": "./bin/dsh-delegate-mcp.d.ts",
      "default": "./bin/dsh-delegate-mcp.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-delegate-mcp": "bin/dsh-delegate-mcp.js",
    "dsh-delegate-codex-agent": "bin/dsh-delegate-codex-agent.js",
    "dsh-delegate-control": "bin/dsh-delegate-control.js",
    "dsh-taskbridge-mcp": "bin/dsh-delegate-mcp.js",
    "dsh-taskbridge-codex-agent": "bin/dsh-delegate-codex-agent.js",
    "dsh-taskbridge-control": "bin/dsh-delegate-control.js"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.d.ts",
    "lib/client.js",
    "lib/client.d.ts",
    "bin/dsh-delegate-mcp.js",
    "bin/dsh-delegate-mcp.d.ts",
    "bin/dsh-delegate-codex-agent.js",
    "bin/dsh-delegate-control.js",
    "bin/dsh-delegate-control.d.ts",
    "codex/dsh-taskbridge.toml",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/auth-contract.md",
    "docs/codex-integration.md",
    "docs/conversation-placement.md",
    "docs/contracts-stage-b.md",
    "docs/redaction-contract.md",
    "docs/runtime-compatibility.md",
    "docs/silent-wait.md",
    "docs/worker-permissions.md",
    "docs/workspace-contract.md",
    "icon.svg",
    "locale/*.json",
    "docs/INTRODUCTION.zh.md",
    "docs/INTRODUCTION.md",
    "docs/taskdispatch-upgrade.md",
    "docs/claude-code.md",
    "docs/plugin-market.md",
    "docs/taskbridge-upgrade.md",
    "docs/releases/1.4.0.zh.md",
    "docs/releases/1.4.0-token-benchmark.zh.md",
    "docs/releases/1.4.1.zh.md",
    "docs/releases/1.4.2.zh.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/dsh-tool-fs": "*",
    "@deepseek-ai/dsh-tool-fs-search": "*",
    "@earendil-works/pi-ai": "^0.87.1 || ^1.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@earendil-works/pi-ai": "^0.87.1",
    "esbuild": "0.25.11"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:isolated": "node --test tests/*.test.js",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "mcp": "node bin/dsh-delegate-mcp.js",
    "codex-agent": "node bin/dsh-delegate-codex-agent.js",
    "control": "node bin/dsh-delegate-control.js",
    "pack:dry": "npm pack --dry-run",
    "build:market": "node scripts/build-plugin-market.mjs",
    "verify:silent-wait": "node scripts/verify-silent-wait.mjs --duration-seconds 1200"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "taskbridge",
    "codex",
    "claude-code",
    "mcp",
    "delegation"
  ],
  "author": "ranranyya",
  "icon": "./icon.svg"
}
