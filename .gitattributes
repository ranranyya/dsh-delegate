# Agent ownership and migration fixtures depend on the exact shipped bytes.
# Preserve their line endings across clones instead of applying core.autocrlf.
codex/dsh-delegate.toml -text whitespace=cr-at-eol
tests/fixtures/*.toml -text whitespace=cr-at-eol
# The generated client bundle is compared byte for byte by `build-client --check`
# (it is written with LF). Converting it on checkout would make that check fail on a
# clean clone even when the bundle is in sync with its sources.
lib/client.js -text
